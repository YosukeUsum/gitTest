{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tetris CLI: 実行",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "externalTerminal",
      "justMyCode": true
    },
    {
      "name": "pytest: 全テスト実行",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
